//@version=6
indicator("ICT Liquidity Map", overlay=true, max_lines_count=500, max_labels_count=500)

// ════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════

show_bsl  = input.bool(true,  "BSL  — Buy Side Liquidity",       group="Visibility")
show_ssl  = input.bool(true,  "SSL  — Sell Side Liquidity",      group="Visibility")
show_mbsl = input.bool(true,  "MBSL — Minor Buy Side (M1/M15)",  group="Visibility")
show_mssl = input.bool(true,  "MSSL — Minor Sell Side (M1/M15)", group="Visibility")
show_pdhl = input.bool(true,  "PDH / PDL — Prev Day Hi/Lo",      group="Visibility")
show_wkhl = input.bool(false, "PWH / PWL — Prev Week Hi/Lo",     group="Visibility")
show_tf   = input.bool(true,  "Show TF Tag in Labels",           group="Visibility")

reh_tol = input.float(0.05, "REH / REL Tolerance (%)",
     minval=0.0, maxval=2.0, step=0.01, group="Swing Settings")
max_lvl = input.int(8, "Max Levels Per Type", minval=2, maxval=25, group="Swing Settings")

lw          = input.int(1,       "Line Width", minval=1, maxval=4, group="Lines & Labels")
ls_major    = input.string("Dashed", "BSL / SSL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
ls_minor    = input.string("Dotted", "MBSL / MSSL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
ls_daily    = input.string("Solid", "PDH / PDL / PWH / PWL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
lb_sz       = input.string("Small", "Label Size",
     options=["Tiny","Small","Normal","Large"], group="Lines & Labels")
extend_bars = input.int(50, "Extension (bars right)",
     minval=1, maxval=500, group="Lines & Labels")

col_bsl  = input.color(#00BCD4, "BSL",  group="Colors", inline="r1")
col_ssl  = input.color(#FF5252, "SSL",  group="Colors", inline="r1")
col_mbsl = input.color(#4DD0E1, "MBSL", group="Colors", inline="r2")
col_mssl = input.color(#FF8A80, "MSSL", group="Colors", inline="r2")
col_pdh  = input.color(#FFD700, "PDH",  group="Colors", inline="r3")
col_pdl  = input.color(#FFA500, "PDL",  group="Colors", inline="r3")
col_wkh  = input.color(#E040FB, "PWH",  group="Colors", inline="r4")
col_wkl  = input.color(#AB47BC, "PWL",  group="Colors", inline="r4")

// ════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════

// bar_ms: constant bar duration in ms from the timeframe setting.
// We use this instead of (time - time[1]) because that formula
// breaks on markets with session gaps (futures, forex weekends):
// the first bar after a gap has a huge (time-time[1]), pushing x2
// tens of thousands of days into the future and making lines jump.
int bar_ms = int(timeframe.in_seconds() * 1000)
int ext_ms = bar_ms * extend_bars

// x2r: right-edge timestamp, updated every bar.
// Pattern from reference indicator (fadizeidan) but with constant
// bar_ms instead of the gap-prone (time - time[1]) formula.
x2r() => time + ext_ms

ls(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

lbsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

// ════════════════════════════════════════════════════════════════
// USER-DEFINED TYPES
// ════════════════════════════════════════════════════════════════

type Level
    float price = 0.0
    int   x1    = 0    // anchor timestamp — re-applied via set_x1() every bar
    line  ln    = na
    label lbl   = na

type LevelGroup
    array<Level> items = na   // CE10133: cannot init arrays inside type block

f_new_group() =>
    LevelGroup.new(array.new<Level>())

// ── add ─────────────────────────────────────────────────────────
// x1 = detection bar time (xloc.bar_time) — stays fixed forever.
// x2 = time + ext_ms — updated every bar by update() so the line
//      grows rightward with the chart.
// Label sits exactly at x2 (line tip). With label.style_label_left
// the label box extends to the RIGHT of x2, so the line ends where
// the label begins — no line visible through the label.
method add(LevelGroup self, float price, int px1, string txt, color col, string lstyle_str) =>
    tol = price * reh_tol / 100.0
    dup = false
    for lvl in self.items
        if math.abs(lvl.price - price) <= tol
            dup := true
            break
    if not dup
        if self.items.size() >= max_lvl
            oldest = self.items.shift()
            oldest.ln.delete()
            oldest.lbl.delete()
        int x1  = not na(px1) ? px1 : time   // anchor to actual pivot bar
        int x2  = x2r()
        ln  = line.new(x1, price, x2, price,
                       xloc=xloc.bar_time, color=col,
                       style=ls(lstyle_str), width=lw)
        lbl = label.new(x2, price, txt,
                        xloc=xloc.bar_time,
                        style=label.style_label_left,
                        color=color.new(col, 10),
                        textcolor=color.white,
                        size=lbsz(lb_sz))
        self.items.push(Level.new(price, x1, ln, lbl))

// ── update ───────────────────────────────────────────────────────
// Called every bar. Grows x2 with the chart (like CheckClaimed in
// the reference indicator). Removes swept levels.
method update(LevelGroup self, bool is_high, bool show, color col, string lstyle_str) =>
    i = 0
    while i < self.items.size()
        lvl   = self.items.get(i)
        swept = is_high ? high >= lvl.price : low <= lvl.price
        if not show or swept
            lvl.ln.delete()
            lvl.lbl.delete()
            self.items.remove(i)
            i   // int return — fixes CE10235
        else
            int x2 = x2r()
            lvl.ln.set_x1(lvl.x1)        // re-anchor x1 every bar (reference indicator pattern)
            lvl.ln.set_x2(x2)
            lvl.ln.set_y1(lvl.price)
            lvl.ln.set_y2(lvl.price)
            lvl.ln.set_color(col)
            lvl.ln.set_style(ls(lstyle_str))
            lvl.ln.set_width(lw)
            lvl.lbl.set_x(x2)
            lvl.lbl.set_color(color.new(col, 10))
            lvl.lbl.set_textcolor(color.white)
            lvl.lbl.set_size(lbsz(lb_sz))
            i += 1

// ════════════════════════════════════════════════════════════════
// MTF REQUESTS  (non-repainting: lookahead_off)
// ════════════════════════════════════════════════════════════════

[m1_sh,  m1_sl,  m1_sh_t,  m1_sl_t]  = request.security(syminfo.tickerid, "1",
    [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1),
     not na(ta.pivothigh(high,1,1)) ? time[1] : na,
     not na(ta.pivotlow(low,1,1))  ? time[1] : na],
    lookahead=barmerge.lookahead_off)
[m15_sh, m15_sl, m15_sh_t, m15_sl_t] = request.security(syminfo.tickerid, "15",
    [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1),
     not na(ta.pivothigh(high,1,1)) ? time[1] : na,
     not na(ta.pivotlow(low,1,1))  ? time[1] : na],
    lookahead=barmerge.lookahead_off)
[h1_sh,  h1_sl,  h1_sh_t,  h1_sl_t]  = request.security(syminfo.tickerid, "60",
    [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1),
     not na(ta.pivothigh(high,1,1)) ? time[1] : na,
     not na(ta.pivotlow(low,1,1))  ? time[1] : na],
    lookahead=barmerge.lookahead_off)
[h4_sh,  h4_sl,  h4_sh_t,  h4_sl_t]  = request.security(syminfo.tickerid, "240",
    [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1),
     not na(ta.pivothigh(high,1,1)) ? time[1] : na,
     not na(ta.pivotlow(low,1,1))  ? time[1] : na],
    lookahead=barmerge.lookahead_off)
[d_hi_p, d_lo_p] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)
[w_hi_p, w_lo_p] = request.security(syminfo.tickerid, "W",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

// ════════════════════════════════════════════════════════════════
// INSTANCES
// ════════════════════════════════════════════════════════════════

var bsl  = f_new_group()
var ssl  = f_new_group()
var mbsl = f_new_group()
var mssl = f_new_group()

// ════════════════════════════════════════════════════════════════
// REH / REL LABEL BUILDERS
// ════════════════════════════════════════════════════════════════

var float last_bsl_p  = na
var float last_ssl_p  = na
var float last_mbsl_p = na
var float last_mssl_p = na

f_bsl_lbl(float price, string tf) =>
    reh  = not na(last_bsl_p) and math.abs(price - last_bsl_p) <= price * reh_tol / 100.0
    base = show_tf ? (reh ? "REH BSL " + tf : "BSL " + tf) : (reh ? "REH BSL" : "BSL")
    base + ": " + str.tostring(price, format.mintick)

f_ssl_lbl(float price, string tf) =>
    rel  = not na(last_ssl_p) and math.abs(price - last_ssl_p) <= price * reh_tol / 100.0
    base = show_tf ? (rel ? "REL SSL " + tf : "SSL " + tf) : (rel ? "REL SSL" : "SSL")
    base + ": " + str.tostring(price, format.mintick)

f_mbsl_lbl(float price, string tf) =>
    reh  = not na(last_mbsl_p) and math.abs(price - last_mbsl_p) <= price * reh_tol / 100.0
    base = show_tf ? (reh ? "REH MBSL " + tf : "MBSL " + tf) : (reh ? "REH MBSL" : "MBSL")
    base + ": " + str.tostring(price, format.mintick)

f_mssl_lbl(float price, string tf) =>
    rel  = not na(last_mssl_p) and math.abs(price - last_mssl_p) <= price * reh_tol / 100.0
    base = show_tf ? (rel ? "REL MSSL " + tf : "MSSL " + tf) : (rel ? "REL MSSL" : "MSSL")
    base + ": " + str.tostring(price, format.mintick)

// ════════════════════════════════════════════════════════════════
// DETECTION  (barstate.isconfirmed → zero repainting)
// ════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    if show_bsl and not na(h1_sh)
        bsl.add(h1_sh, h1_sh_t, f_bsl_lbl(h1_sh, "H1"), col_bsl, ls_major)
        last_bsl_p := h1_sh
    if show_bsl and not na(h4_sh)
        bsl.add(h4_sh, h4_sh_t, f_bsl_lbl(h4_sh, "H4"), col_bsl, ls_major)
        last_bsl_p := h4_sh
    if show_ssl and not na(h1_sl)
        ssl.add(h1_sl, h1_sl_t, f_ssl_lbl(h1_sl, "H1"), col_ssl, ls_major)
        last_ssl_p := h1_sl
    if show_ssl and not na(h4_sl)
        ssl.add(h4_sl, h4_sl_t, f_ssl_lbl(h4_sl, "H4"), col_ssl, ls_major)
        last_ssl_p := h4_sl
    if show_mbsl and not na(m1_sh)
        mbsl.add(m1_sh, m1_sh_t, f_mbsl_lbl(m1_sh, "M1"), col_mbsl, ls_minor)
        last_mbsl_p := m1_sh
    if show_mbsl and not na(m15_sh)
        mbsl.add(m15_sh, m15_sh_t, f_mbsl_lbl(m15_sh, "M15"), col_mbsl, ls_minor)
        last_mbsl_p := m15_sh
    if show_mssl and not na(m1_sl)
        mssl.add(m1_sl, m1_sl_t, f_mssl_lbl(m1_sl, "M1"), col_mssl, ls_minor)
        last_mssl_p := m1_sl
    if show_mssl and not na(m15_sl)
        mssl.add(m15_sl, m15_sl_t, f_mssl_lbl(m15_sl, "M15"), col_mssl, ls_minor)
        last_mssl_p := m15_sl

// ════════════════════════════════════════════════════════════════
// UPDATE every bar (mirrors CheckClaimed pattern)
// ════════════════════════════════════════════════════════════════

bsl.update(true,  show_bsl,  col_bsl,  ls_major)
ssl.update(false, show_ssl,  col_ssl,  ls_major)
mbsl.update(true,  show_mbsl, col_mbsl, ls_minor)
mssl.update(false, show_mssl, col_mssl, ls_minor)

// ════════════════════════════════════════════════════════════════
// PDH / PDL
// ════════════════════════════════════════════════════════════════

// Track the bar where each day's high/low was actually formed (reference indicator pattern)
var float cur_day_hi   = na
var int   cur_day_hi_t = na
var float cur_day_lo   = na
var int   cur_day_lo_t = na

var line  pdh_ln  = na
var line  pdl_ln  = na
var label pdh_lbl = na
var label pdl_lbl = na
var int   pdh_x1  = na
var int   pdl_x1  = na

bool new_day = ta.change(time("D")) != 0

// Update daily high/low tracking
if new_day
    pdh_x1       := na(cur_day_hi_t) ? time : cur_day_hi_t
    pdl_x1       := na(cur_day_lo_t) ? time : cur_day_lo_t
    cur_day_hi   := high
    cur_day_hi_t := time
    cur_day_lo   := low
    cur_day_lo_t := time
else
    if na(cur_day_hi) or high >= cur_day_hi
        cur_day_hi   := high
        cur_day_hi_t := time
    if na(cur_day_lo) or low <= cur_day_lo
        cur_day_lo   := low
        cur_day_lo_t := time

if (new_day or na(pdh_ln)) and not na(d_hi_p)
    pdh_ln.delete()
    pdl_ln.delete()
    pdh_lbl.delete()
    pdl_lbl.delete()
    int x2   = x2r()
    pdh_ln  := line.new(time, d_hi_p, x2, d_hi_p, xloc=xloc.bar_time, color=na, width=1)
    pdl_ln  := line.new(time, d_lo_p, x2, d_lo_p, xloc=xloc.bar_time, color=na, width=1)
    pdh_lbl := label.new(x2, d_hi_p, "PDH: " + str.tostring(d_hi_p, format.mintick),
                         xloc=xloc.bar_time, style=label.style_label_left,
                         color=na, textcolor=na, size=size.small)
    pdl_lbl := label.new(x2, d_lo_p, "PDL: " + str.tostring(d_lo_p, format.mintick),
                         xloc=xloc.bar_time, style=label.style_label_left,
                         color=na, textcolor=na, size=size.small)

if not na(pdh_ln)
    int x2 = x2r()
    pdh_ln.set_x1(pdh_x1)
    pdh_ln.set_x2(x2)
    pdh_ln.set_y1(d_hi_p)
    pdh_ln.set_y2(d_hi_p)
    pdh_ln.set_color(show_pdhl ? col_pdh : na)
    pdh_ln.set_style(ls(ls_daily))
    pdh_ln.set_width(show_pdhl ? lw : 0)
    pdh_lbl.set_x(x2)
    pdh_lbl.set_textcolor(show_pdhl ? color.white : na)
    pdh_lbl.set_color(show_pdhl ? color.new(col_pdh, 10) : na)
    pdh_lbl.set_size(lbsz(lb_sz))

if not na(pdl_ln)
    int x2 = x2r()
    pdl_ln.set_x1(pdl_x1)
    pdl_ln.set_x2(x2)
    pdl_ln.set_y1(d_lo_p)
    pdl_ln.set_y2(d_lo_p)
    pdl_ln.set_color(show_pdhl ? col_pdl : na)
    pdl_ln.set_style(ls(ls_daily))
    pdl_ln.set_width(show_pdhl ? lw : 0)
    pdl_lbl.set_x(x2)
    pdl_lbl.set_textcolor(show_pdhl ? color.white : na)
    pdl_lbl.set_color(show_pdhl ? color.new(col_pdl, 10) : na)
    pdl_lbl.set_size(lbsz(lb_sz))

// ════════════════════════════════════════════════════════════════
// PWH / PWL
// ════════════════════════════════════════════════════════════════

// Track the bar where each week's high/low was actually formed
var float cur_wk_hi   = na
var int   cur_wk_hi_t = na
var float cur_wk_lo   = na
var int   cur_wk_lo_t = na

var line  pwh_ln  = na
var line  pwl_ln  = na
var label pwh_lbl = na
var label pwl_lbl = na
var int   pwh_x1  = na
var int   pwl_x1  = na

bool new_week = ta.change(time("W")) != 0

// Update weekly high/low tracking
if new_week
    pwh_x1       := na(cur_wk_hi_t) ? time : cur_wk_hi_t
    pwl_x1       := na(cur_wk_lo_t) ? time : cur_wk_lo_t
    cur_wk_hi    := high
    cur_wk_hi_t  := time
    cur_wk_lo    := low
    cur_wk_lo_t  := time
else
    if na(cur_wk_hi) or high >= cur_wk_hi
        cur_wk_hi   := high
        cur_wk_hi_t := time
    if na(cur_wk_lo) or low <= cur_wk_lo
        cur_wk_lo   := low
        cur_wk_lo_t := time

if (new_week or na(pwh_ln)) and not na(w_hi_p)
    pwh_ln.delete()
    pwl_ln.delete()
    pwh_lbl.delete()
    pwl_lbl.delete()
    int x2   = x2r()
    pwh_ln  := line.new(time, w_hi_p, x2, w_hi_p, xloc=xloc.bar_time, color=na, width=1)
    pwl_ln  := line.new(time, w_lo_p, x2, w_lo_p, xloc=xloc.bar_time, color=na, width=1)
    pwh_lbl := label.new(x2, w_hi_p, "PWH: " + str.tostring(w_hi_p, format.mintick),
                         xloc=xloc.bar_time, style=label.style_label_left,
                         color=na, textcolor=na, size=size.small)
    pwl_lbl := label.new(x2, w_lo_p, "PWL: " + str.tostring(w_lo_p, format.mintick),
                         xloc=xloc.bar_time, style=label.style_label_left,
                         color=na, textcolor=na, size=size.small)

if not na(pwh_ln)
    int x2 = x2r()
    pwh_ln.set_x1(pwh_x1)
    pwh_ln.set_x2(x2)
    pwh_ln.set_y1(w_hi_p)
    pwh_ln.set_y2(w_hi_p)
    pwh_ln.set_color(show_wkhl ? col_wkh : na)
    pwh_ln.set_style(ls(ls_daily))
    pwh_ln.set_width(show_wkhl ? lw : 0)
    pwh_lbl.set_x(x2)
    pwh_lbl.set_textcolor(show_wkhl ? color.white : na)
    pwh_lbl.set_color(show_wkhl ? color.new(col_wkh, 10) : na)
    pwh_lbl.set_size(lbsz(lb_sz))

if not na(pwl_ln)
    int x2 = x2r()
    pwl_ln.set_x1(pwl_x1)
    pwl_ln.set_x2(x2)
    pwl_ln.set_y1(w_lo_p)
    pwl_ln.set_y2(w_lo_p)
    pwl_ln.set_color(show_wkhl ? col_wkl : na)
    pwl_ln.set_style(ls(ls_daily))
    pwl_ln.set_width(show_wkhl ? lw : 0)
    pwl_lbl.set_x(x2)
    pwl_lbl.set_textcolor(show_wkhl ? color.white : na)
    pwl_lbl.set_color(show_wkhl ? color.new(col_wkl, 10) : na)
    pwl_lbl.set_size(lbsz(lb_sz))
