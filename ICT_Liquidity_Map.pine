//@version=6
indicator("ICT Liquidity Map", overlay=true, max_lines_count=500, max_labels_count=500)

// ════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════

// ── Visibility ──────────────────────────────────────────────────
show_bsl  = input.bool(true,  "BSL  — Buy Side Liquidity",       group="Visibility")
show_ssl  = input.bool(true,  "SSL  — Sell Side Liquidity",      group="Visibility")
show_mbsl = input.bool(true,  "MBSL — Minor Buy Side (M1/M15)",  group="Visibility")
show_mssl = input.bool(true,  "MSSL — Minor Sell Side (M1/M15)", group="Visibility")
show_pdhl = input.bool(true,  "PDH / PDL — Prev Day Hi/Lo",      group="Visibility")
show_wkhl = input.bool(false, "PWH / PWL — Prev Week Hi/Lo",     group="Visibility")
show_tf   = input.bool(true,  "Show Timeframe Tag in Labels",    group="Visibility")

// ── Swing Settings ──────────────────────────────────────────────
reh_tol = input.float(0.05, "REH/REL Tolerance (%)",
     minval=0.0, maxval=2.0, step=0.01, group="Swing Settings",
     tooltip="Two swing levels within this % of each other are labelled REH or REL")
max_lvl = input.int(8, "Max Levels Per Type", minval=2, maxval=25, group="Swing Settings",
     tooltip="Oldest level is removed when this limit is reached")

// ── Lines & Labels ──────────────────────────────────────────────
lw       = input.int(1, "Line Width", minval=1, maxval=4, group="Lines & Labels")
ls_major = input.string("Dashed", "BSL / SSL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
ls_minor = input.string("Dotted", "MBSL / MSSL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
ls_daily = input.string("Solid",  "PDH / PDL / PWH / PWL Style",
     options=["Solid","Dashed","Dotted"], group="Lines & Labels")
lb_sz    = input.string("Small", "Label Size",
     options=["Tiny","Small","Normal","Large"], group="Lines & Labels")
lbl_off  = input.int(0, "Label Offset (bars right of line end)",
     minval=0, maxval=20, group="Lines & Labels",
     tooltip="0 = label sits exactly at line end (interrupted effect)")

// ── Colors ──────────────────────────────────────────────────────
col_bsl  = input.color(#00BCD4, "BSL",  group="Colors", inline="r1")
col_ssl  = input.color(#FF5252, "SSL",  group="Colors", inline="r1")
col_mbsl = input.color(#4DD0E1, "MBSL", group="Colors", inline="r2")
col_mssl = input.color(#FF8A80, "MSSL", group="Colors", inline="r2")
col_pdh  = input.color(#FFD700, "PDH",  group="Colors", inline="r3")
col_pdl  = input.color(#FFA500, "PDL",  group="Colors", inline="r3")
col_wkh  = input.color(#E040FB, "PWH",  group="Colors", inline="r4")
col_wkl  = input.color(#AB47BC, "PWL",  group="Colors", inline="r4")

// ════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_lbsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

// ════════════════════════════════════════════════════════════════
// USER-DEFINED TYPE — LevelGroup
// Encapsulates prices · lines · labels for one liquidity class
// ════════════════════════════════════════════════════════════════

type LevelGroup
    array<float> prices = na
    array<line>  lines  = na
    array<label> labels = na

// Factory — arrays cannot be initialised inside the type block (CE10133)
f_new_group() =>
    LevelGroup.new(array.new<float>(), array.new<line>(), array.new<label>())

// Add a new level; no-op on duplicates within REH/REL tolerance
method add(LevelGroup self, float price, string txt, color col, string lstyle) =>
    tol = price * reh_tol / 100.0
    dup = false
    sz  = self.prices.size()
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(self.prices.get(i) - price) <= tol
                dup := true
                break
    if not dup
        if self.prices.size() >= max_lvl
            self.lines.shift().delete()
            self.labels.shift().delete()
            self.prices.shift()
        ln  = line.new(bar_index, price, bar_index, price,
             color=col, style=lstyle, width=lw)
        lbl = label.new(bar_index + lbl_off, price, txt,
             color=color.new(col, 78), textcolor=col,
             style=label.style_label_left, size=f_lbsz(lb_sz))
        self.prices.push(price)
        self.lines.push(ln)
        self.labels.push(lbl)

// Extend lines to current bar, reposition labels, remove swept levels.
// is_high=true  → BSL/MBSL: swept when high >= level price
// is_high=false → SSL/MSSL: swept when low  <= level price
method update(LevelGroup self, bool is_high, bool show) =>
    i = 0
    while i < self.prices.size()
        price = self.prices.get(i)
        swept = is_high ? high >= price : low <= price
        if not show or swept
            self.lines.get(i).delete()
            self.labels.get(i).delete()
            self.prices.remove(i)
            self.lines.remove(i)
            self.labels.remove(i)
            i  // both branches return int — fixes CE10235
        else
            self.lines.get(i).set_x2(bar_index)
            self.labels.get(i).set_x(bar_index + lbl_off)
            i += 1

// ════════════════════════════════════════════════════════════════
// MTF SECURITY REQUESTS  (non-repainting: lookahead_off)
// ta.pivothigh(high,1,1) → confirmed exactly 1 bar after the pivot
// ════════════════════════════════════════════════════════════════

[m1_sh,  m1_sl]  = request.security(syminfo.tickerid, "1",
     [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1)],
     lookahead=barmerge.lookahead_off)

[m15_sh, m15_sl] = request.security(syminfo.tickerid, "15",
     [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1)],
     lookahead=barmerge.lookahead_off)

[h1_sh,  h1_sl]  = request.security(syminfo.tickerid, "60",
     [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1)],
     lookahead=barmerge.lookahead_off)

[h4_sh,  h4_sl]  = request.security(syminfo.tickerid, "240",
     [ta.pivothigh(high,1,1), ta.pivotlow(low,1,1)],
     lookahead=barmerge.lookahead_off)

// Confirmed previous-bar reference levels (lookahead_on is safe here
// because we explicitly request high[1]/low[1] — always historical data)
[d_hi_p, d_lo_p] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

[w_hi_p, w_lo_p] = request.security(syminfo.tickerid, "W",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

// ════════════════════════════════════════════════════════════════
// LEVEL INSTANCES
// ════════════════════════════════════════════════════════════════

var bsl  = f_new_group()
var ssl  = f_new_group()
var mbsl = f_new_group()
var mssl = f_new_group()

// ════════════════════════════════════════════════════════════════
// REH / REL LABEL BUILDERS
// ════════════════════════════════════════════════════════════════

var float last_bsl_p  = na
var float last_ssl_p  = na
var float last_mbsl_p = na
var float last_mssl_p = na

f_bsl_lbl(float price, string tf) =>
    reh = not na(last_bsl_p) and math.abs(price - last_bsl_p) <= price * reh_tol / 100.0
    show_tf ? (reh ? "REH BSL " + tf : "BSL " + tf) : (reh ? "REH BSL" : "BSL")

f_ssl_lbl(float price, string tf) =>
    rel = not na(last_ssl_p) and math.abs(price - last_ssl_p) <= price * reh_tol / 100.0
    show_tf ? (rel ? "REL SSL " + tf : "SSL " + tf) : (rel ? "REL SSL" : "SSL")

f_mbsl_lbl(float price, string tf) =>
    reh = not na(last_mbsl_p) and math.abs(price - last_mbsl_p) <= price * reh_tol / 100.0
    show_tf ? (reh ? "REH MBSL " + tf : "MBSL " + tf) : (reh ? "REH MBSL" : "MBSL")

f_mssl_lbl(float price, string tf) =>
    rel = not na(last_mssl_p) and math.abs(price - last_mssl_p) <= price * reh_tol / 100.0
    show_tf ? (rel ? "REL MSSL " + tf : "MSSL " + tf) : (rel ? "REL MSSL" : "MSSL")

// ════════════════════════════════════════════════════════════════
// MAIN DETECTION  (confirmed bars only → zero repainting)
// ════════════════════════════════════════════════════════════════

if barstate.isconfirmed
    maj = f_lstyle(ls_major)
    min = f_lstyle(ls_minor)

    // ── BSL: H1 pivot highs ────────────────────────────────────
    if show_bsl and not na(h1_sh)
        bsl.add(h1_sh, f_bsl_lbl(h1_sh, "H1"), col_bsl, maj)
        last_bsl_p := h1_sh

    // ── BSL: H4 pivot highs ────────────────────────────────────
    if show_bsl and not na(h4_sh)
        bsl.add(h4_sh, f_bsl_lbl(h4_sh, "H4"), col_bsl, maj)
        last_bsl_p := h4_sh

    // ── SSL: H1 pivot lows ─────────────────────────────────────
    if show_ssl and not na(h1_sl)
        ssl.add(h1_sl, f_ssl_lbl(h1_sl, "H1"), col_ssl, maj)
        last_ssl_p := h1_sl

    // ── SSL: H4 pivot lows ─────────────────────────────────────
    if show_ssl and not na(h4_sl)
        ssl.add(h4_sl, f_ssl_lbl(h4_sl, "H4"), col_ssl, maj)
        last_ssl_p := h4_sl

    // ── MBSL: M1 pivot highs ───────────────────────────────────
    if show_mbsl and not na(m1_sh)
        mbsl.add(m1_sh, f_mbsl_lbl(m1_sh, "M1"), col_mbsl, min)
        last_mbsl_p := m1_sh

    // ── MBSL: M15 pivot highs ──────────────────────────────────
    if show_mbsl and not na(m15_sh)
        mbsl.add(m15_sh, f_mbsl_lbl(m15_sh, "M15"), col_mbsl, min)
        last_mbsl_p := m15_sh

    // ── MSSL: M1 pivot lows ────────────────────────────────────
    if show_mssl and not na(m1_sl)
        mssl.add(m1_sl, f_mssl_lbl(m1_sl, "M1"), col_mssl, min)
        last_mssl_p := m1_sl

    // ── MSSL: M15 pivot lows ───────────────────────────────────
    if show_mssl and not na(m15_sl)
        mssl.add(m15_sl, f_mssl_lbl(m15_sl, "M15"), col_mssl, min)
        last_mssl_p := m15_sl

// ════════════════════════════════════════════════════════════════
// UPDATE ALL LEVELS (every bar)
// ════════════════════════════════════════════════════════════════

bsl.update(true,  show_bsl)
ssl.update(false, show_ssl)
mbsl.update(true,  show_mbsl)
mssl.update(false, show_mssl)

// ════════════════════════════════════════════════════════════════
// PDH / PDL  — Previous Day High/Low
// ════════════════════════════════════════════════════════════════

var line  pdh_ln  = na
var line  pdl_ln  = na
var label pdh_lbl = na
var label pdl_lbl = na

if show_pdhl
    if ta.change(time("D")) != 0
        pdh_ln.delete()
        pdl_ln.delete()
        pdh_lbl.delete()
        pdl_lbl.delete()
        pdh_ln  := line.new(bar_index, d_hi_p, bar_index, d_hi_p,
             color=col_pdh, style=f_lstyle(ls_daily), width=lw)
        pdl_ln  := line.new(bar_index, d_lo_p, bar_index, d_lo_p,
             color=col_pdl, style=f_lstyle(ls_daily), width=lw)
        pdh_lbl := label.new(bar_index + lbl_off, d_hi_p, "PDH",
             color=color.new(col_pdh, 78), textcolor=col_pdh,
             style=label.style_label_left, size=f_lbsz(lb_sz))
        pdl_lbl := label.new(bar_index + lbl_off, d_lo_p, "PDL",
             color=color.new(col_pdl, 78), textcolor=col_pdl,
             style=label.style_label_left, size=f_lbsz(lb_sz))
    if not na(pdh_ln)
        pdh_ln.set_x2(bar_index)
        pdh_lbl.set_x(bar_index + lbl_off)
    if not na(pdl_ln)
        pdl_ln.set_x2(bar_index)
        pdl_lbl.set_x(bar_index + lbl_off)

// ════════════════════════════════════════════════════════════════
// PWH / PWL  — Previous Week High/Low
// ════════════════════════════════════════════════════════════════

var line  pwh_ln  = na
var line  pwl_ln  = na
var label pwh_lbl = na
var label pwl_lbl = na

if show_wkhl
    if ta.change(time("W")) != 0
        pwh_ln.delete()
        pwl_ln.delete()
        pwh_lbl.delete()
        pwl_lbl.delete()
        pwh_ln  := line.new(bar_index, w_hi_p, bar_index, w_hi_p,
             color=col_wkh, style=line.style_dashed, width=lw)
        pwl_ln  := line.new(bar_index, w_lo_p, bar_index, w_lo_p,
             color=col_wkl, style=line.style_dashed, width=lw)
        pwh_lbl := label.new(bar_index + lbl_off, w_hi_p, "PWH",
             color=color.new(col_wkh, 78), textcolor=col_wkh,
             style=label.style_label_left, size=f_lbsz(lb_sz))
        pwl_lbl := label.new(bar_index + lbl_off, w_lo_p, "PWL",
             color=color.new(col_wkl, 78), textcolor=col_wkl,
             style=label.style_label_left, size=f_lbsz(lb_sz))
    if not na(pwh_ln)
        pwh_ln.set_x2(bar_index)
        pwh_lbl.set_x(bar_index + lbl_off)
    if not na(pwl_ln)
        pwl_ln.set_x2(bar_index)
        pwl_lbl.set_x(bar_index + lbl_off)
